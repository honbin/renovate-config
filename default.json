{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["cargo", "npm", "github-actions"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-11 * * 6"],
  "dependencyDashboard": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep 0.x updates separate because minor bumps may introduce breaking changes.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "cargo non-major",
      "groupSlug": "cargo-non-major"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "npm non-major",
      "groupSlug": "npm-non-major"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github-actions non-major",
      "groupSlug": "github-actions-non-major"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-11 1 * *"]
  }
}
